# AI-ассистент и AI-справка. Без ключа всё остальное (пайплайн, CSV, интерфейс) работает.
# Провайдер: openai | nvidia
LLM_PROVIDER=openai
OPENAI_API_KEY=
NVIDIA_API_KEY=
# Модель (необязательно). По умолчанию: openai → gpt-4.1-mini, nvidia → meta/llama-3.3-70b-instruct
# Для NVIDIA выбирайте на build.nvidia.com модель с поддержкой tool calling.
LLM_MODEL=
